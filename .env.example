# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4317

# Session HMAC for generation / chat quotas (server-side).
SESSION_SECRET=replace-with-long-random-string

# Text and image model providers — all secrets are server-side only.
AI_TEXT_PROVIDER=
AI_TEXT_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AI_IMAGE_PROVIDER=google
AI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GOOGLE_GEMINI_API_KEY=
REPLICATE_API_TOKEN=
IMAGE_API_KEY=
IMAGE_API_BASE_URL=
IMAGE_MODEL=

# Abuse and cost limits. Enforce server-side, not in browser state only.
AI_MAX_IMAGES_PER_SESSION=2
AI_MAX_CHAT_TURNS_PER_SESSION=24
AI_CHAT_REQUESTS_PER_MINUTE=8
AI_DAILY_IMAGE_LIMIT=100
AI_MAX_ACTIVE_JOBS_PER_SESSION=1
AI_CONCEPT_TTL_HOURS=72
AI_DAILY_SPEND_LIMIT_USD=
AI_GENERATION_KILL_SWITCH=false

# Telegram: AI concept handoff sends image + caption to internal sales chat via Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_CUSTOMER_CHAT_LINK=
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/touchform_md

# Storage/database only after choosing and securing an implementation.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=concept-previews

# Optional abuse challenge if selected after research.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
