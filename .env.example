# Touchform.md — local / preview secrets (never commit real values)

# HMAC secret for session cookie (generation limits). Dev fallback exists if unset.
SESSION_SECRET=replace-with-long-random-string

# Optional LLM (OpenAI-compatible). Without it, /api/consult uses the catalog mock consultant.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional image generation. Without it, /api/generate returns an SVG concept stub.
IMAGE_API_KEY=
IMAGE_API_BASE_URL=
IMAGE_MODEL=

# Telegram Bot API — required for real manager handoff with attachments.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
# Public deep-link shown to visitors (e.g. https://t.me/your_touchform_bot)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/touchform_md

# Site URL for canonical / sitemap
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4317
